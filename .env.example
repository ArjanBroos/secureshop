# GitHub Actions secrets — add these in GitHub Settings → Secrets → Actions

# Infisical machine identity (used by deploy.yml to fetch environment secrets)
# Create a machine identity in Infisical → Project Settings → Machine Identities
INFISICAL_CLIENT_ID=
INFISICAL_CLIENT_SECRET=
INFISICAL_PROJECT_SLUG=

# Render deploy hooks — found in Render dashboard → service → Settings → Deploy Hook
RENDER_STAGING_BACKEND_DEPLOY_HOOK=
RENDER_STAGING_FRONTEND_DEPLOY_HOOK=
RENDER_PROD_BACKEND_DEPLOY_HOOK=
RENDER_PROD_FRONTEND_DEPLOY_HOOK=

# Public URLs of deployed services (used to poll health checks after deploy)
STAGING_URL=
PROD_URL=
